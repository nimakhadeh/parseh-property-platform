# -----------------------------------------------------------------------
# فایل نمونه متغیرهای محیطی - این فایل را به .env کپی کرده و مقادیر را تنظیم کنید
# cp .env.example .env
# نکته مهم: مقادیری که فارسی یا دارای فاصله هستند باید داخل کوتیشن باشند
# -----------------------------------------------------------------------

# جنگو
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com,SERVER_IP
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=False

# مسیر پنل ادمین - حتماً قبل از استقرار روی سرور واقعی تغییرش بده (بدون / در ابتدا، با / در انتها)
# مثال امن: ADMIN_URL=parseh-x7k9-manage/
ADMIN_URL=admin/

# دیتابیس PostgreSQL
DB_NAME=parseh_db
DB_USER=parseh_user
DB_PASSWORD=CHANGE-ME-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# اطلاعات سایت (چون مقدار فارسی و دارای فاصله است، حتماً داخل کوتیشن بماند)
SITE_NAME="پلتفرم املاک پارسه"
SITE_PHONE=021-00000000
SITE_WHATSAPP=989120000000
SITE_EMAIL=info@parseh-estate.ir
SITE_ADDRESS="تهران، خیابان ولیعصر"

# اعلان تلگرام برای درخواست‌های تماس جدید (اختیاری - خالی بگذارید تا غیرفعال بماند)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ایمیل (اختیاری - SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
